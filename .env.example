# Copy to .env and fill in. Never commit real values.

# Pooled Postgres connection used by the app at runtime
DATABASE_URL=
# Direct (non-pooled) connection used by `prisma migrate`
DIRECT_URL=

# Long random string used to sign session cookies
SESSION_SECRET=

# Email provider for sign-up / password-reset codes (https://www.brevo.com)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional
NEXT_PUBLIC_SITE_URL=
